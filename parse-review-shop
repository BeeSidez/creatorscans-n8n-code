// Parse Shop Review — extracts ALL fields from Vertex AI response
const items = $input.all();

return items.map(item => {
  const rawResponse = item.json.candidates[0].content.parts[0].text;

  let parsed;
  if (typeof rawResponse === 'string') {
    let clean = rawResponse.trim();
    if (clean.startsWith('```json')) {
      clean = clean.replace(/```json\n?/g, '').replace(/```\n?/g, '');
    }
    clean = clean.replace(/\bNone\b/g, 'null');
    parsed = JSON.parse(clean);
  } else {
    parsed = rawResponse;
  }

  return {
    json: {
      verification_status: parsed.verification_status || '',
      ai_confidence_score: parsed.ai_confidence_score || 0,
      rejection_reason: parsed.rejection_reason || null,
      concept_name: parsed.concept_name || '',
      content_summary: parsed.content_summary || '',
      product_identified: parsed.product_identified || null,
      overall_score: parsed.overall_score || 0,
      ai_feedback: parsed.overall_comment || '',
      ai_suggested_action: parsed.focus_for_next_video || '',
      metrics_analysis: parsed.metrics_analysis || '',
      submission_quality: parsed.submission_quality || '',
      needs_manual_review: parsed.needs_manual_review || false,
      score_1: typeof parsed.score_1 === 'number' ? parsed.score_1 : null,
      score_1_comment: parsed.score_1_comment || '',
      score_2: typeof parsed.score_2 === 'number' ? parsed.score_2 : null,
      score_2_comment: parsed.score_2_comment || '',
      score_3: typeof parsed.score_3 === 'number' ? parsed.score_3 : null,
      score_3_comment: parsed.score_3_comment || '',
      score_4: typeof parsed.score_4 === 'number' ? parsed.score_4 : null,
      score_4_comment: parsed.score_4_comment || '',
      score_5: typeof parsed.score_5 === 'number' ? parsed.score_5 : null,
      score_5_comment: parsed.score_5_comment || '',
    }
  };
});
