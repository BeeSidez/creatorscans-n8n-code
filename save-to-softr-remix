// n8n Code node — Split storyboard into individual items (REMIX path)
// Place AFTER the parse node
// The NEXT node (Softr create record / HTTP request) runs once per item automatically

// Remix path
const scriptRecordId = $('Script2').first().json.id;

// Get parsed data from the parse node (Code in JavaScript1)
const parsed = $('Code in JavaScript1').first().json;
const script = parsed.script;
const storyboard = parsed.storyboard;

// Helper: split comma-separated strings into arrays for multi-select fields
const toArray = (val) => {
  if (!val || val === 'None' || val === 'null') return [];
  return String(val).split(',').map(v => v.trim()).filter(Boolean);
};

// Helper: clean null/None to empty string
const clean = (val) => {
  if (val === null || val === undefined || val === 'None' || val === 'null') return '';
  return String(val);
};

// Return one item per storyboard frame
return storyboard.map(frame => {
  return {
    json: {
      // Parent link
      script_table_id: scriptRecordId,

      // Script-level data (repeated per frame for convenience)
      concept_name: script.concept_name || '',

      // Frame data
      frame_number: frame.frame_number,

      // Multi-select fields → arrays (Softr needs arrays, not comma strings)
      section: toArray(frame.section),
      shot_type: toArray(frame.shot_type),
      voiceover_tag: toArray(frame.voiceover_tag),
      visual_action_tag: toArray(frame.visual_action_tag),

      // Long text fields
      section_detail: clean(frame.section_detail),
      shot_detail: clean(frame.shot_detail),
      voiceover: clean(frame.voiceover),
      script_text: clean(frame.script),
      caption: clean(frame.caption),
      caption_detail: clean(frame.caption_detail),
      visual_action: clean(frame.visual_action),
      visual_action_detail: clean(frame.visual_action_detail),
      creative_note: clean(frame.creative_note),

      // Script path only (will be empty/null for remix)
      timestamp: frame.timestamp !== undefined ? frame.timestamp : null,
      screenshot_url: frame.screenshot_url || '',
    }
  };
});
