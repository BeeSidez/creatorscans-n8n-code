// n8n Code node — Split storyboard into individual items
// Place AFTER the parse node (parse-script or parse-remix)
// The NEXT node (Softr create record / HTTP request) runs once per item automatically

// Get the parent Script record ID
// Remix path
const scriptRecordId = $('Script2').first().json.id;

// Get parsed data from the parse node (Code in JavaScript1)
const parsed = $('Code in JavaScript1').first().json;
const script = parsed.script;
const storyboard = parsed.storyboard;

// Return one item per storyboard frame
return storyboard.map(frame => {
  return {
    json: {
      // Parent link
      script_table_id: scriptRecordId,

      // Script-level data (repeated per frame for convenience)
      concept_name: script.concept_name || '',

      // Frame data
      frame_number: frame.frame_number,
      section: frame.section || '',
      section_detail: frame.section_detail || '',
      shot_type: frame.shot_type || '',
      shot_detail: frame.shot_detail || '',
      voiceover_tag: frame.voiceover_tag === null || frame.voiceover_tag === 'None' ? '' : (frame.voiceover_tag || ''),
      voiceover: frame.voiceover === null || frame.voiceover === 'None' || frame.voiceover === 'null' ? '' : (frame.voiceover || ''),
      script_text: frame.script === null || frame.script === 'None' || frame.script === 'null' ? '' : (frame.script || ''),
      caption: frame.caption === null || frame.caption === 'None' || frame.caption === 'null' ? '' : (frame.caption || ''),
      caption_detail: frame.caption_detail === null || frame.caption_detail === 'None' || frame.caption_detail === 'null' ? '' : (frame.caption_detail || ''),
      visual_action_tag: frame.visual_action_tag || '',
      visual_action: frame.visual_action || '',
      visual_action_detail: frame.visual_action_detail || '',
      creative_note: frame.creative_note || '',

      // Script path only (will be empty/null for remix)
      timestamp: frame.timestamp !== undefined ? frame.timestamp : null,
      screenshot_url: frame.screenshot_url || '',
    }
  };
});
